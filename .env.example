# ตัวอย่างไฟล์ตั้งค่า
#   - รันแบบไม่ใช้ Container : คัดลอกเป็น backend/.env
#   - รันด้วย docker compose  : คัดลอกเป็น .env ที่รากโปรเจกต์ (compose อ่านไฟล์นี้อัตโนมัติ)
# ห้าม commit ไฟล์ .env ที่มีค่าจริงลงใน Repository

# ============================================================================
#  ส่วนที่ 1 — ใช้ตอนรัน Back-end โดยตรงบนเครื่อง (ไม่ใช้ Container)
# ============================================================================

# --- Back-end ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# --- ฐานข้อมูล PostgreSQL ---
# กำหนด DATABASE_URL อย่างเดียวก็ได้ หรือจะกำหนด PG* ทีละตัวก็ได้
# DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/psu_activities
PGHOST=localhost
PGPORT=5432
PGDATABASE=psu_activities
PGUSER=app_user
PGPASSWORD=CHANGE_ME

# ============================================================================
#  ส่วนที่ 2 — ใช้ตอนรันด้วย docker compose
#  (ค่า PGHOST/PGPORT ของ Back-end ถูกกำหนดไว้ใน docker-compose.yml แล้ว
#   จึงไม่ต้องแก้ค่าในส่วนที่ 1 เมื่อรันแบบ Container)
# ============================================================================

# --- ฐานข้อมูลใน Container ---
POSTGRES_DB=psu_activities
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- แอปพลิเคชัน ---
# APP_PORT = พอร์ตบนเครื่อง host ที่เปิดให้ผู้ใช้เข้าถึงหน้าเว็บ
APP_PORT=8080
APP_VERSION=1.0.0
PGPOOL_MAX=10
TZ=Asia/Bangkok

# --- Container Image ---
# เปลี่ยน IMAGE_REGISTRY เป็น ghcr.io/<org>/<repo> เมื่อดึง image จาก registry
IMAGE_REGISTRY=local
IMAGE_TAG=latest

# --- การสำรองข้อมูล ---
# BACKUP_DIR             ที่เก็บไฟล์สำรองข้อมูลบนเครื่อง host
# BACKUP_CRON            รอบเวลาสำรองข้อมูล (ค่าเริ่มต้น 02:00 ของทุกวัน)
# BACKUP_RETENTION_DAYS  เก็บไฟล์สำรองข้อมูลย้อนหลังกี่วัน
# BACKUP_ON_START        สำรองข้อมูลทันทีหนึ่งครั้งเมื่อ container เริ่มทำงาน
BACKUP_DIR=./backups
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_ON_START=true

# --- ระบบเฝ้าระวัง (profile: monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
